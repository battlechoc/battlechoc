# copy to .env next to docker-compose.yml on the server (never commit the real file)

# the published API image and the release to run: a version (5.3.0) stays put until you
# change it, `latest` follows every release with the next `docker compose pull`
API_IMAGE=fabianbormann/battlechoc-api
API_TAG=latest
# the Docker volume with the database (required). A server that started from a checkout of
# the repository has its data in `deploy_pgdata` (`docker volume ls`): keep that name here,
# another name starts with an empty database.
PGDATA_VOLUME=battlechoc_pgdata

# only with docker-compose.caddy.yml (Caddy in Docker fetches the certificate for it)
API_DOMAIN=api.battlechoc.com
POSTGRES_PASSWORD=change-me
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
# comma separated origins of the PWA
CORS_ORIGINS=https://battlechoc.com,http://localhost:3000
# web push keys: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@battlechoc.com
# the private recipe table of the lab on the VPS (chmod 600, never in the repository);
# the API refuses to start in production without it
RECIPES_PATH=/opt/battlechoc/private/recipes.json

# optional: signing in with a Cardano key (saving progress with 24 recovery words) on that
# network, preprod or mainnet. Without it the feature is off. The game's build needs the same
# network in VITE_CARDANO_NETWORK.
#CARDANO_NETWORK=preprod

# optional. Without MATCH_RETENTION_DAYS every finished match keeps its actions and snapshot
# for ever; with a number of days the API removes them that long after the match ended (the
# result stays). DB_POOL_MAX (10) and DB_STATEMENT_TIMEOUT_MS (15000) tune the database pool.
#MATCH_RETENTION_DAYS=90
#DB_POOL_MAX=10
#DB_STATEMENT_TIMEOUT_MS=15000

# optional: the chain features (minted items on preprod, see README.md "Chain features"). Off
# while these lines stay commented. COMPOSE_PROFILES=chain also starts the chain index (Yaci
# Store, about 1 to 1.5 GB of RAM more); the API needs CARDANO_NETWORK above as well.
#COMPOSE_PROFILES=chain
# the database password of the index's own role yaci_store: `openssl rand -hex 24`
#YACI_STORE_DB_PASSWORD=
# where the index starts reading the chain: deploy.js prints both lines (a block 20 below the tip
# right before the deployment, `indexStart` in contracts/deployments/preprod.json), see README.md
#YACI_SYNC_START_SLOT=
#YACI_SYNC_START_BLOCKHASH=
# the Cardano relay the index follows; the defaults are preprod's (mainnet:
# backbone.cardano.iog.io, 3001, 764824073)
#YACI_CARDANO_HOST=preprod-node.play.dev.cardano.org
#YACI_CARDANO_PORT=3001
#YACI_PROTOCOL_MAGIC=1
# the ids the contracts' deploy script prints (apps/api/scripts/chain/deploy.js)
#CHAIN_POLICY_ID=
#CHAIN_CONFIG_REF=
# optional: the config policy (deploy.js prints it as CHAIN_CONFIG_POLICY_ID); with it the API finds
# the config by its NFT, so an admin update of the config needs no new CHAIN_CONFIG_REF
#CHAIN_CONFIG_POLICY_ID=
# the server's signing key file on the VPS (never in the repository); the API runs as uid 1000:
# sudo chown 1000:1000 <file> && sudo chmod 600 <file>
#CHAIN_SERVER_KEY_PATH=/opt/battlechoc/private/chain-server.key
# where the API reads the chain and submits: Koios (the default, `koios`) or a
# Blockfrost-compatible API (`blockfrost`, e.g. https://cardano-preprod.blockfrost.io/api/v0)
#CHAIN_PROVIDER_KIND=koios
#CHAIN_PROVIDER_URL=https://preprod.koios.rest/api/v1
# a secret: with Koios a bearer token, recommended (a free koios.rest token: the public tier
# without one limits a request to 1 kB, less than a mint); required with Blockfrost (the project id)
#CHAIN_PROVIDER_KEY=
# the depth from which a transaction counts as final (1 to 2160; 10 on preprod, 20 to 30 on
# mainnet; README.md "Turning it on"); set it last, once the index has caught up
#CHAIN_K_FINAL=
# optional: how often the API reads the chain (default 20000 ms) and how old the index's newest
# block may be before the API stops trusting it (default 600000 ms, 10 minutes)
#CHAIN_WATCH_INTERVAL_MS=20000
#CHAIN_INDEX_MAX_LAG_MS=600000
