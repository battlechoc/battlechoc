# copy to .env next to docker-compose.yml on the server (never commit the real file)

# the published API image and the release to run: a version (5.3.0) stays put until you
# change it, `latest` follows every release with the next `docker compose pull`
API_IMAGE=fabianbormann/battlechoc-api
API_TAG=latest
# the Docker volume with the database (required). A server that started from a checkout of
# the repository has its data in `deploy_pgdata` (`docker volume ls`): keep that name here,
# another name starts with an empty database.
PGDATA_VOLUME=battlechoc_pgdata

# only with docker-compose.caddy.yml (Caddy in Docker fetches the certificate for it)
API_DOMAIN=api.battlechoc.com
POSTGRES_PASSWORD=change-me
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
# comma separated origins of the PWA
CORS_ORIGINS=https://battlechoc.com,http://localhost:3000
# web push keys: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@battlechoc.com
# the private recipe table of the lab on the VPS (chmod 600, never in the repository);
# the API refuses to start in production without it
RECIPES_PATH=/opt/battlechoc/private/recipes.json
