{
  "name": "battlechoc-monorepo",
  "version": "5.8.0",
  "private": true,
  "description": "battlechoc: a chocolate-themed two-player strategy game",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/shared",
    "apps/pwa",
    "apps/api"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/pwa",
    "dev:expose": "npm run dev -w apps/pwa -- --host",
    "build": "npm run build -w apps/pwa",
    "test": "npm test -w packages/shared",
    "test:e2e": "npm test -w apps/pwa",
    "test:api": "npm test -w apps/api",
    "start:api": "npm start -w apps/api",
    "test:unit": "npm run test:unit -w apps/pwa",
    "whitepaper:simulate": "node whitepaper/simulator/run.js",
    "test:whitepaper": "node --test 'whitepaper/simulator/test/*.test.js'",
    "test:changelog": "node --test .github/scripts/pr-changelog.test.js",
    "check:build": "test -d apps/pwa/build && ! grep -rlE '__battlechoc|testclock' apps/pwa/build",
    "verify": "npm run format:check && npm run lint && npm run test:changelog && npm test && npm run test:unit && npm run test:whitepaper && npm run test:api && npm run build && npm run check:build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
