{
  "name": "battlechoc-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "battlechoc: a chocolate-themed two-player strategy game",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/shared",
    "apps/pwa",
    "apps/api"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/pwa",
    "build": "npm run build -w apps/pwa",
    "test": "npm test -w packages/shared",
    "test:e2e": "npm test -w apps/pwa",
    "test:api": "npm test -w apps/api",
    "start:api": "npm start -w apps/api",
    "test:unit": "npm run test:unit -w apps/pwa",
    "whitepaper:simulate": "node whitepaper/simulator/run.js",
    "test:whitepaper": "node --test 'whitepaper/simulator/test/*.test.js'"
  }
}
