rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{report} {
      allow create: if true;
    }
    
    match /multiplayerGameSessions/{session} {
    	allow create: if true;
      allow update: if true;
      allow read: if true;
    }
    
    match /status/{status} {
    	allow read, write: if true;
    }
  }
}