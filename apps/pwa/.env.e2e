# the e2e build (`npm run build:e2e`, into build-e2e/): the game with its test hooks, see src/testHooks.js
VITE_TEST_HOOKS=true
# Tests that need the server set the local one (localStorage "battlechoc.apiUrl", started by
# playwright.config.js); every other test stays offline. Without this the e2e build talked to the
# live api.battlechoc.com and created accounts there (found 2026-11-05).
VITE_API_URL=http://127.0.0.1:9
