{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      },
      {
        "source": "/api",
        "function": "api"
      }
    ],
    "headers": [ {
      "source": "**/*.html",
      "headers": [ {
        "key": "Cache-Control",
        "value": "max-age=0, no-cache"
      } ]
    }, {
      "source": "**/*.@(jpg|jpeg|gif|png|gltf|js|css|mp3)",
      "headers": [ {
        "key": "Cache-Control",
        "value": "max-age=1209600"
      } ]
    } ]
  }
}
