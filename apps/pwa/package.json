  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@battlechoc/battlechoc-shared-functions": "^3.0.0",
    "@cardano-foundation/cardano-connect-with-wallet": "0.2.22",
    "@evolution-sdk/evolution": "0.8.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@scure/bip39": "2.4.0",
    "babylonjs-gltf2interface": "^9.30.0",
    "canvas-confetti": "^1.9.4",
    "idb": "^8.0.4",
    "react": "^19.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.0",
    "react-jss": "^10.10.0",
    "react-redux": "^9.3.0",
    "styled-components": "6.6.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.link.config.js",
    "build:e2e": "vite build --mode e2e --outDir build-e2e && vite build --config vite.link.config.js --mode e2e --outDir build-e2e",
    "test": "npm run build:e2e && playwright test",
    "live-testing": "npm run build:e2e && playwright test --headed",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "models:optimize": "node dev/optimize-models.mjs",
    "images:optimize": "node dev/optimize-images.mjs",
    "icons": "node dev/icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
